// ─── Product catalogue ───────────────────────────────────────────────────────
// A Product is the marketing/catalogue entity (e.g. "Oud Royale Eau de Parfum").
// A ProductVariant is the sellable SKU (e.g. the 100 ml bottle) with its own
// SKU, barcode, status and per-market prices. Catalogue rows referenced by
// history are deactivated, never deleted (see docs/BUSINESS_RULES.md).

enum ProductType {
  FRAGRANCE
  GIFT_SET
  BODY_CARE
  HOME_FRAGRANCE
  ACCESSORY
  SAMPLE
  OTHER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  INACTIVE
  DISCONTINUED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum Audience {
  MEN
  WOMEN
  UNISEX
}

enum NoteLayer {
  TOP
  HEART
  BASE
}

enum BarcodeType {
  EAN_13
  EAN_8
  UPC_A
  GTIN_14
  CODE_128
}

/// MANUFACTURER = GTIN printed on the packaging by the brand owner.
/// INTERNAL = code assigned by us for internal scanning only (never presented
/// as a GS1-registered GTIN).
enum BarcodeSource {
  MANUFACTURER
  INTERNAL
}

enum ComplianceStatus {
  PENDING
  ACTIVE
  EXPIRED
  REJECTED
  NOT_REQUIRED
}

model Brand {
  id                  String   @id @default(uuid(7)) @db.Uuid
  slug                String   @unique @db.VarChar(120)
  nameEn              String   @map("name_en") @db.VarChar(120)
  nameAr              String   @map("name_ar") @db.VarChar(120)
  descriptionEn       String?  @map("description_en")
  descriptionAr       String?  @map("description_ar")
  /// ISO 3166-1 alpha-2 country of the brand (any country, not only markets).
  countryOfOriginCode String?  @map("country_of_origin_code") @db.Char(2)
  websiteUrl          String?  @map("website_url") @db.VarChar(300)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@index([isActive])
  @@map("brands")
}

model Category {
  id            String   @id @default(uuid(7)) @db.Uuid
  slug          String   @unique @db.VarChar(120)
  parentId      String?  @map("parent_id") @db.Uuid
  nameEn        String   @map("name_en") @db.VarChar(120)
  nameAr        String   @map("name_ar") @db.VarChar(120)
  descriptionEn String?  @map("description_en")
  descriptionAr String?  @map("description_ar")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent          Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[]        @relation("CategoryTree")
  products        ProductCategory[]
  primaryProducts Product[]         @relation("ProductPrimaryCategory")

  @@index([parentId])
  @@map("categories")
}

/// Configurable olfactive families (Woody, Floral, Amber, …).
model FragranceFamily {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(40)
  nameEn    String   @map("name_en") @db.VarChar(80)
  nameAr    String   @map("name_ar") @db.VarChar(80)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("fragrance_families")
}

/// Configurable concentrations (Extrait, EDP, EDT, EDC, perfume oil, …).
model Concentration {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(40)
  nameEn    String   @map("name_en") @db.VarChar(80)
  nameAr    String   @map("name_ar") @db.VarChar(80)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("fragrance_concentrations")
}

model FragranceNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique @db.VarChar(80)
  nameEn    String   @map("name_en") @db.VarChar(80)
  nameAr    String   @map("name_ar") @db.VarChar(80)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products ProductFragranceNote[]

  @@map("fragrance_notes")
}

model Product {
  id                    String        @id @default(uuid(7)) @db.Uuid
  slug                  String        @unique @db.VarChar(160)
  type                  ProductType   @default(FRAGRANCE)
  status                ProductStatus @default(DRAFT)
  brandId               String        @map("brand_id") @db.Uuid
  /// Main category (breadcrumbs, canonical listing). Must also be one of the
  /// product's categories — enforced by the catalogue service.
  primaryCategoryId     String?       @map("primary_category_id") @db.Uuid
  nameEn                String        @map("name_en") @db.VarChar(200)
  nameAr                String        @map("name_ar") @db.VarChar(200)
  shortDescriptionEn    String?       @map("short_description_en") @db.VarChar(400)
  shortDescriptionAr    String?       @map("short_description_ar") @db.VarChar(400)
  descriptionEn         String?       @map("description_en")
  descriptionAr         String?       @map("description_ar")
  audience              Audience?
  concentrationId       String?       @map("concentration_id") @db.Uuid
  fragranceFamilyId     String?       @map("fragrance_family_id") @db.Uuid
  countryOfOriginCode   String?       @map("country_of_origin_code") @db.Char(2)
  manufacturerName      String?       @map("manufacturer_name") @db.VarChar(200)
  ingredientsEn         String?       @map("ingredients_en")
  ingredientsAr         String?       @map("ingredients_ar")
  warningsEn            String?       @map("warnings_en")
  warningsAr            String?       @map("warnings_ar")
  storageInstructionsEn String?       @map("storage_instructions_en")
  storageInstructionsAr String?       @map("storage_instructions_ar")
  seoTitleEn            String?       @map("seo_title_en") @db.VarChar(160)
  seoTitleAr            String?       @map("seo_title_ar") @db.VarChar(160)
  seoDescriptionEn      String?       @map("seo_description_en") @db.VarChar(320)
  seoDescriptionAr      String?       @map("seo_description_ar") @db.VarChar(320)
  launchYear            Int?          @map("launch_year") @db.SmallInt
  /// Normalised (Arabic + Latin) text used for search; maintained by the
  /// catalogue service whenever names, brand, SKUs or barcodes change.
  searchText            String        @default("") @map("search_text")
  publishedAt           DateTime?     @map("published_at") @db.Timestamptz(3)
  discontinuedAt        DateTime?     @map("discontinued_at") @db.Timestamptz(3)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand           Brand                  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  primaryCategory Category?              @relation("ProductPrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  concentration   Concentration?         @relation(fields: [concentrationId], references: [id], onDelete: Restrict)
  family          FragranceFamily?       @relation(fields: [fragranceFamilyId], references: [id], onDelete: Restrict)
  variants        ProductVariant[]
  categories      ProductCategory[]
  notes           ProductFragranceNote[]
  images          ProductImage[]
  compliance      ProductCompliance[]

  @@index([status])
  @@index([brandId])
  @@index([primaryCategoryId])
  @@index([createdAt])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_search_text_trgm_idx")
  @@map("products")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductFragranceNote {
  productId String    @map("product_id") @db.Uuid
  noteId    String    @map("note_id") @db.Uuid
  layer     NoteLayer
  sortOrder Int       @default(0) @map("sort_order")

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  note    FragranceNote @relation(fields: [noteId], references: [id], onDelete: Restrict)

  @@id([productId, noteId, layer])
  @@index([noteId])
  @@map("product_fragrance_notes")
}

model ProductVariant {
  id             String         @id @default(uuid(7)) @db.Uuid
  productId      String         @map("product_id") @db.Uuid
  /// Upper-cased, trimmed; unique across the catalogue.
  sku            String         @unique @db.VarChar(64)
  /// Digits only for GTIN types; unique across the catalogue when present.
  barcode        String?        @unique @db.VarChar(64)
  barcodeType    BarcodeType?   @map("barcode_type")
  barcodeSource  BarcodeSource? @map("barcode_source")
  /// Optional display label; the UI falls back to the volume (e.g. "100 ml").
  nameEn         String?        @map("name_en") @db.VarChar(120)
  nameAr         String?        @map("name_ar") @db.VarChar(120)
  sizeMl         Decimal?       @map("size_ml") @db.Decimal(8, 2)
  weightGrams    Int?           @map("weight_grams")
  isTester       Boolean        @default(false) @map("is_tester")
  status         VariantStatus  @default(ACTIVE)
  trackInventory Boolean        @default(true) @map("track_inventory")
  trackBatches   Boolean        @default(true) @map("track_batches")
  trackExpiry    Boolean        @default(false) @map("track_expiry")
  sortOrder      Int            @default(0) @map("sort_order")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  prices  ProductPrice[]
  images  ProductImage[]

  stockBalances  StockBalance[]
  stockMovements StockMovement[]

  @@index([productId])
  @@index([status])
  @@map("product_variants")
}

/// Current selling price of a variant in one market. Historical prices are
/// preserved on transactions (order/invoice snapshots) and in the audit log.
model ProductPrice {
  id              String   @id @default(uuid(7)) @db.Uuid
  variantId       String   @map("variant_id") @db.Uuid
  countryCode     String   @map("country_code") @db.Char(2)
  currencyCode    String   @map("currency_code") @db.Char(3)
  amount          Decimal  @db.Decimal(14, 2)
  /// Optional "was" price for display; must be greater than `amount`.
  compareAtAmount Decimal? @map("compare_at_amount") @db.Decimal(14, 2)
  /// Inactive prices hide the variant from that market without losing the value.
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  /// Composite FK: the price currency must be the market's currency. ON UPDATE
  /// RESTRICT stops a currency change from silently relabelling amounts.
  country  Country        @relation(fields: [countryCode, currencyCode], references: [code, currencyCode], onDelete: Restrict, onUpdate: Restrict)
  currency Currency       @relation(fields: [currencyCode], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@unique([variantId, countryCode])
  @@index([countryCode, isActive])
  @@map("product_prices")
}

model ProductImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  variantId  String?  @map("variant_id") @db.Uuid
  /// Key in the configured file storage (local disk in development).
  storageKey String   @unique @map("storage_key") @db.VarChar(300)
  mimeType   String   @map("mime_type") @db.VarChar(64)
  sizeBytes  Int      @map("size_bytes")
  width      Int?
  height     Int?
  altEn      String?  @map("alt_en") @db.VarChar(200)
  altAr      String?  @map("alt_ar") @db.VarChar(200)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// Country-specific regulatory references for a product (e.g. SFDA cosmetics
/// notification, EDA registration). Requirements are not assumed identical
/// across products; see docs/COUNTRY_COMPLIANCE.md.
model ProductCompliance {
  id              String           @id @default(uuid(7)) @db.Uuid
  productId       String           @map("product_id") @db.Uuid
  countryCode     String           @map("country_code") @db.Char(2)
  authority       String           @db.VarChar(40)
  referenceType   String           @map("reference_type") @db.VarChar(60)
  referenceNumber String?          @map("reference_number") @db.VarChar(80)
  status          ComplianceStatus @default(PENDING)
  issuedAt        DateTime?        @map("issued_at") @db.Date
  expiresAt       DateTime?        @map("expires_at") @db.Date
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryCode], references: [code], onDelete: Restrict)

  @@index([productId])
  @@index([countryCode, status])
  @@map("product_compliance")
}
