# ──────────────────────────────────────────────────────────────────────────────
# Perfume Commerce — environment variables
# Copy to `.env` for local development:  cp .env.example .env
# Never commit real secrets. Production values belong in your hosting
# provider's secret manager.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (PostgreSQL 15+; 16 recommended).
# Matches docker-compose.yml for local development.
DATABASE_URL="postgresql://perfume:perfume_dev_password@localhost:5432/perfume_dev?schema=public"

# Separate database used by the automated integration / e2e tests.
# The test runner RESETS this database — never point it at real data.
TEST_DATABASE_URL="postgresql://perfume:perfume_dev_password@localhost:5432/perfume_test?schema=public"

# Public base URL of the application (no trailing slash). Used for auth
# callbacks, CSRF origin checks and absolute URLs (SEO, sitemap).
APP_URL="http://localhost:3000"

# Secret used by Better Auth to sign session cookies and encrypt tokens.
# REQUIRED. At least 32 characters. Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Authentication rate limiting (sign-in throttling). Defaults to "true" in
# production and "false" in development/test when unset.
# AUTH_RATE_LIMIT_ENABLED="true"

# Default storefront market when the visitor has not chosen one (ISO 3166-1
# alpha-2 code of an active country: SA or EG).
DEFAULT_MARKET="SA"

# Time zone used to display back-office dates (IANA name).
APP_TIME_ZONE="Asia/Riyadh"

# File storage for product images.
#   local → files are written to STORAGE_LOCAL_DIR and served by /api/files
#           (development / single-server deployments only).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"

# Development seed — creates a Super Admin with these credentials.
# If SEED_ADMIN_PASSWORD is empty, the seed generates a random password and
# prints it once. The seed refuses to run when NODE_ENV=production.
SEED_ADMIN_EMAIL="admin@perfume.local"
SEED_ADMIN_PASSWORD=""

# Required for multi-instance / self-hosted production deployments so that
# Server Action references stay valid across instances (32-byte base64 key).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
